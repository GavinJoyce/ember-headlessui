{
  "name": "ember-headlessui",
  "version": "0.18.0",
  "description": "The default blueprint for ember-cli addons.",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GavinJoyce/ember-headlessui.git"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:js": "rollup --config",
    "build:types": "node -e \"require('fs').rmSync('declarations', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel 'lint:!(fix)'",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:other": "prettier --check \"**/*.{json,md,yml}\"",
    "lint:other:fix": "prettier --write \"**/*.{json,md,yml}\"",
    "start": "npm-run-all --parallel start:*",
    "test": "npm-run-all lint test:*",
    "release": "dotenv release-it --",
    "prepack": "pnpm build",
    "start:js": "rollup --config --watch",
    "start:types": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.0",
    "@embroider/macros": "^1.19.0",
    "decorator-transforms": "^2.3.0",
    "ember-concurrency": "^5.3.0",
    "ember-element-helper": "^0.8.8",
    "ember-modifier": "^4.3.0",
    "ember-truth-helpers": "^5.0.0",
    "focus-trap": "^6.7.1",
    "tracked-built-ins": "^4.1.2"
  },
  "peerDependencies": {
    "@glimmer/component": ">= 1.0.4",
    "ember-source": ">= 4.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@embroider/addon-dev": "^8.5.0",
    "@glimmer/component": "^1.0.4",
    "@glimmer/tracking": "^1.0.4",
    "@nullvoxpopuli/eslint-configs": "^1.5.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@types/ember": "^4.0.0",
    "@types/ember__application": "^4.0.0",
    "@types/ember__array": "^4.0.1",
    "@types/ember__component": "^4.0.8",
    "@types/ember__debug": "^4.0.1",
    "@types/ember__destroyable": "^4.0.0",
    "@types/ember__error": "^4.0.0",
    "@types/ember__object": "^4.0.2",
    "@types/ember__owner": "^4.0.9",
    "@types/ember__polyfills": "^4.0.0",
    "@types/ember__runloop": "^4.0.1",
    "@types/ember__service": "^4.0.0",
    "@types/ember__string": "^3.0.9",
    "@types/ember__template": "^4.0.0",
    "@types/ember__utils": "^4.0.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-ember-template-compilation": "^2.4.0",
    "dotenv-cli": "^4.0.0",
    "ember-source": "~4.8.0",
    "ember-template-lint": "^3.5.1",
    "ember-template-lint-plugin-prettier": "^2.0.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-ember": "^10.5.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "lerna-changelog": "^2.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.2",
    "release-it": "^14.14.3",
    "release-it-lerna-changelog": "^3.1.0",
    "rollup": "^4.40.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 20"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/combobox.js": "./dist/_app_/components/combobox.js",
      "./components/combobox/-button.js": "./dist/_app_/components/combobox/-button.js",
      "./components/combobox/-input.js": "./dist/_app_/components/combobox/-input.js",
      "./components/combobox/-label.js": "./dist/_app_/components/combobox/-label.js",
      "./components/combobox/-option.js": "./dist/_app_/components/combobox/-option.js",
      "./components/combobox/-options.js": "./dist/_app_/components/combobox/-options.js",
      "./components/dialog.js": "./dist/_app_/components/dialog.js",
      "./components/dialog/-description.js": "./dist/_app_/components/dialog/-description.js",
      "./components/dialog/-overlay.js": "./dist/_app_/components/dialog/-overlay.js",
      "./components/dialog/-title.js": "./dist/_app_/components/dialog/-title.js",
      "./components/listbox.js": "./dist/_app_/components/listbox.js",
      "./components/listbox/-button.js": "./dist/_app_/components/listbox/-button.js",
      "./components/listbox/-label.js": "./dist/_app_/components/listbox/-label.js",
      "./components/listbox/-option.js": "./dist/_app_/components/listbox/-option.js",
      "./components/listbox/-options.js": "./dist/_app_/components/listbox/-options.js",
      "./components/menu.js": "./dist/_app_/components/menu.js",
      "./components/menu/button.js": "./dist/_app_/components/menu/button.js",
      "./components/menu/item-element.js": "./dist/_app_/components/menu/item-element.js",
      "./components/menu/item.js": "./dist/_app_/components/menu/item.js",
      "./components/menu/items.js": "./dist/_app_/components/menu/items.js",
      "./components/radio-group.js": "./dist/_app_/components/radio-group.js",
      "./components/radio-group/-label.js": "./dist/_app_/components/radio-group/-label.js",
      "./components/radio-group/-option.js": "./dist/_app_/components/radio-group/-option.js",
      "./components/switch.js": "./dist/_app_/components/switch.js",
      "./components/switch/button.js": "./dist/_app_/components/switch/button.js",
      "./components/switch/label.js": "./dist/_app_/components/switch/label.js",
      "./components/transition.js": "./dist/_app_/components/transition.js",
      "./components/transition/child.js": "./dist/_app_/components/transition/child.js",
      "./helpers/tag-name-is-component.js": "./dist/_app_/helpers/tag-name-is-component.js",
      "./modifiers/headlessui-focus-trap.js": "./dist/_app_/modifiers/headlessui-focus-trap.js",
      "./services/dialog-stack-provider.js": "./dist/_app_/services/dialog-stack-provider.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "volta": {
    "node": "22.22.2"
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  }
}
