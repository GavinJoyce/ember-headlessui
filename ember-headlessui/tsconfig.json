{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,

    // rollup builds the JavaScript; tsc only emits type declarations
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "declarations",
    "rootDir": "src",

    // src imports .ts files by extension so rollup can resolve them
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"]
}
